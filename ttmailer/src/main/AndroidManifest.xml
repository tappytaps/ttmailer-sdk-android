<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Rich push (TTM-624): finding a browser with Custom Tabs on Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application>
        <!-- The in-app message of a rich push; started only by TTMailer.handle. -->
        <activity
            android:name=".TTMailerMessageActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard"
            android:theme="@style/TTMailer.Message" />
    </application>
</manifest>
